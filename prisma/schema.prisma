generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH.JS MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.VarChar(120)
  cedula        String?   @db.VarChar(20)
  phone         String?   @db.VarChar(20)

  // Terms & Privacy acceptance
  terminosAceptados         Boolean   @default(false)
  terminosVersion           String?   @db.VarChar(10)
  terminosFechaAceptacion   DateTime?
  terminosIp                String?   @db.VarChar(45)
  privacidadAceptada        Boolean   @default(false)
  privacidadFechaAceptacion DateTime?
  userAgent                 String?   @db.VarChar(500)

  // Welcome offer tracking
  ofertaBienvenidaUsada Boolean   @default(false)
  fechaPrimeraCompra    DateTime?

  // Saldo a favor (Bs) acumulado por sobrepagos
  saldoBs Decimal @default(0) @db.Decimal(14, 2)
  role          Role      @default(PARTICIPANT)
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  quinielas             Quiniela[]
  predictions           Prediction[]
  tournamentPredictions TournamentPrediction[]
  telegramSubscription  TelegramSubscription?
  paymentReports        PaymentReport[]
  createdSubQuinielas    SubQuiniela[]
  subQuinielaMemberships SubQuinielaMember[]
  saldosFavor           SaldoFavor[]
  ganadores             Ganador[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  PARTICIPANT
  BOT
}

enum MatchPhase {
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINALS
  SEMI_FINALS
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum TournamentPredictionType {
  CHAMPION
  RUNNER_UP
  THIRD_PLACE
  TOP_SCORER
  GROUP_WINNER
  GROUP_RUNNER_UP
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubQuinielaMemberRole {
  ADMIN
  MEMBER
}

// ==========================================
// QUINIELA (supports multiple per user)
// ==========================================

model Quiniela {
  id        String   @id @default(cuid())
  name      String
  userId    String
  isTest    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictions            Prediction[]
  tournamentPredictions  TournamentPrediction[]
  score                  QuinielaScore?
  subQuinielaMemberships SubQuinielaMember[]
  ganador                Ganador?

  @@index([isTest])
  @@map("quinielas")
}

// ==========================================
// TOURNAMENT DATA
// ==========================================

model Team {
  id      String  @id @default(cuid())
  name    String  @unique
  code    String  @unique @db.VarChar(3)
  flag    String?
  groupId String?

  group Group? @relation(fields: [groupId], references: [id])

  homeMatches           Match[]                @relation("HomeTeam")
  awayMatches           Match[]                @relation("AwayTeam")
  tournamentPredictions TournamentPrediction[]

  @@map("teams")
}

model Group {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(1)

  teams   Team[]
  matches Match[]

  @@map("groups")
}

model Venue {
  id      String @id @default(cuid())
  name    String
  city    String
  country String

  matches Match[]

  @@map("venues")
}

model Match {
  id          String      @id @default(cuid())
  matchNumber Int         @unique
  phase       MatchPhase
  groupId     String?
  venueId     String?
  dateTime    DateTime

  homeTeamId String?
  awayTeamId String?

  homeScore   Int?
  awayScore   Int?
  homePenalty Int?
  awayPenalty Int?

  status MatchStatus @default(SCHEDULED)
  locked Boolean     @default(false)

  group    Group? @relation(fields: [groupId], references: [id])
  venue    Venue? @relation(fields: [venueId], references: [id])
  homeTeam Team?  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team?  @relation("AwayTeam", fields: [awayTeamId], references: [id])

  predictions Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phase])
  @@index([dateTime])
  @@index([status])
  @@map("matches")
}

// ==========================================
// PREDICTIONS (scoped to quiniela)
// ==========================================

model Prediction {
  id         String  @id @default(cuid())
  userId     String
  quinielaId String
  matchId    String
  homeScore  Int
  awayScore  Int
  isWildcard Boolean @default(false)
  points     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiniela Quiniela @relation(fields: [quinielaId], references: [id], onDelete: Cascade)
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([quinielaId, matchId])
  @@index([matchId])
  @@index([userId])
  @@map("predictions")
}

model TournamentPrediction {
  id         String                   @id @default(cuid())
  userId     String
  quinielaId String
  type       TournamentPredictionType
  teamId     String?
  groupId    String?
  playerName String?
  points     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiniela Quiniela @relation(fields: [quinielaId], references: [id], onDelete: Cascade)
  team     Team?    @relation(fields: [teamId], references: [id])

  @@unique([quinielaId, type, groupId])
  @@index([type])
  @@index([userId])
  @@map("tournament_predictions")
}

// ==========================================
// SCORING / LEADERBOARD (per quiniela)
// ==========================================

model QuinielaScore {
  id               String @id @default(cuid())
  quinielaId       String @unique
  totalPoints      Int    @default(0)
  exactScores      Int    @default(0)
  correctResults   Int    @default(0)
  partialScores    Int    @default(0)
  groupPoints      Int    @default(0)
  knockoutPoints   Int    @default(0)
  tournamentPoints Int    @default(0)
  wildcardPoints   Int    @default(0)
  rank             Int?

  quiniela Quiniela @relation(fields: [quinielaId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([totalPoints(sort: Desc)])
  @@index([rank])
  @@map("quiniela_scores")
}

// ==========================================
// TOURNAMENT RESULTS (admin-set actuals)
// ==========================================

model TournamentResult {
  id         String                   @id @default(cuid())
  type       TournamentPredictionType
  teamId     String?
  groupId    String?
  playerName String?

  createdAt DateTime @default(now())

  @@unique([type, groupId])
  @@map("tournament_results")
}

// ==========================================
// TELEGRAM
// ==========================================

model TelegramSubscription {
  id     String @id @default(cuid())
  userId String @unique
  chatId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("telegram_subscriptions")
}

// ==========================================
// PAYMENTS / CREDITS
// ==========================================

model PaymentReport {
  id            String        @id @default(cuid())
  userId        String
  credits       Int
  amount        Decimal       @db.Decimal(10, 2)
  method        String
  reference     String
  notes         String?
  proofUrl      String?
  status        PaymentStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectionNote String?

  // Package-based purchase (nullable for backward compat with legacy credit-only reports)
  packageId         String?
  promoApplied      Boolean  @default(false)
  quinielasGranted  Int      @default(0)

  // Bs payment tracking (captured from OCR when available)
  amountBs      Decimal?  @db.Decimal(14, 2)
  paymentDate   DateTime?
  bcvRateUsd    Decimal?  @db.Decimal(14, 4)
  bcvRateEur    Decimal?  @db.Decimal(14, 4)

  // Saldo a favor (Bs) usado o creado por este pago
  saldoUsadoBs   Decimal? @db.Decimal(14, 2)
  saldoCreadoBs  Decimal? @db.Decimal(14, 2)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  saldosOriginados SaldoFavor[] @relation("OrigenSaldo")
  saldosConsumidos SaldoFavor[] @relation("UsoSaldo")

  @@index([userId])
  @@index([status])
  @@map("payment_reports")
}

// ==========================================
// SUB-QUINIELAS (private friend groups)
// ==========================================

model SubQuiniela {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(200)
  inviteCode  String   @unique @db.VarChar(8)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members   SubQuinielaMember[]

  @@index([inviteCode])
  @@map("sub_quinielas")
}

model SubQuinielaMember {
  id            String                @id @default(cuid())
  subQuinielaId String
  userId        String
  quinielaId    String
  role          SubQuinielaMemberRole @default(MEMBER)
  joinedAt      DateTime              @default(now())

  subQuiniela SubQuiniela @relation(fields: [subQuinielaId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiniela    Quiniela    @relation(fields: [quinielaId], references: [id], onDelete: Cascade)

  @@unique([subQuinielaId, userId])
  @@index([userId])
  @@index([quinielaId])
  @@map("sub_quiniela_members")
}

// ==========================================
// ADMIN LOG
// ==========================================

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("admin_logs")
}

model Package {
  id                    String   @id @default(cuid())
  code                  String   @unique @db.VarChar(20)
  name                  String   @db.VarChar(50)
  description           String?  @db.VarChar(200)
  priceUsd              Decimal  @db.Decimal(10, 2)
  quinielasCount        Int
  bonusQuinielasOferta  Int      @default(0)
  badge                 String?  @db.VarChar(30)
  sortOrder             Int      @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paymentReports PaymentReport[]

  @@map("packages")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  source    String   @default("BCV") @db.VarChar(20)
  usdRate   Decimal  @db.Decimal(14, 4)
  eurRate   Decimal  @db.Decimal(14, 4)
  fetchedAt DateTime @default(now())
  rawData   Json?

  @@index([fetchedAt])
  @@map("exchange_rates")
}

model SiteConfig {
  key       String   @id @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_config")
}

model SaldoFavor {
  id              String   @id @default(cuid())
  userId          String
  montoUsd        Decimal  @db.Decimal(10, 2)
  montoBs         Decimal  @db.Decimal(14, 2)
  tasaEurBcv      Decimal  @db.Decimal(14, 4)
  origenPaymentId String?
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  usedInPaymentId String?
  notes           String?  @db.VarChar(300)
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  origenPayment PaymentReport? @relation("OrigenSaldo", fields: [origenPaymentId], references: [id], onDelete: SetNull)
  usedInPayment PaymentReport? @relation("UsoSaldo", fields: [usedInPaymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isUsed])
  @@map("saldos_favor")
}

enum GanadorStatus {
  PENDIENTE_DATOS
  DATOS_RECIBIDOS
  PAGADO
  NO_RECLAMADO
}

model Ganador {
  id              String         @id @default(cuid())
  quinielaId      String         @unique
  userId          String
  posicion        Int            // 1, 2, 3
  puntosFinales   Int
  empatadosCon    Int            @default(1) // 1 = sin empate, 2+ = dividido entre N
  premioUsd       Decimal        @db.Decimal(14, 2)

  // Datos de cobro (los llena el ganador)
  bancoCobro      String?        @db.VarChar(50)
  telefonoCobro   String?        @db.VarChar(20)
  cedulaCobro     String?        @db.VarChar(20)
  notasCobro      String?        @db.VarChar(500)
  fechaDatosCobro DateTime?

  // Datos del pago (los llena el admin)
  status          GanadorStatus  @default(PENDIENTE_DATOS)
  tasaEurBcvPago  Decimal?       @db.Decimal(14, 4)
  montoPagadoBs   Decimal?       @db.Decimal(14, 2)
  metodoPago      String?        @db.VarChar(50)
  referenciaPago  String?        @db.VarChar(100)
  comprobanteUrl  String?        @db.VarChar(300)
  notasAdmin      String?        @db.VarChar(500)
  fechaPago       DateTime?
  pagadoPor       String?

  fechaOtorgado   DateTime       @default(now())
  fechaLimite     DateTime       // 30 dias para reclamar

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiniela        Quiniela       @relation(fields: [quinielaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("ganadores")
}
